#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------
# PRODUCTION: APP_ENV must be "production" and APP_DEBUG must be false.
# Leaving APP_DEBUG=true in production exposes stack traces, file paths and
# environment values on any error page.
APP_NAME="AiToolyfy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Public site
#--------------------------------------------------------------------------
# SITE_URL is used for canonical tags, Open Graph URLs, the sitemap and the
# Sitemap line in robots.txt. In production this MUST be the https:// apex
# domain you want indexed, with no trailing slash.
SITE_URL=http://localhost
SITE_NAME="AiToolyfy"
SITE_LOCALE=en
SITE_TAGLINE="Free online tools for documents, text and everyday tasks"
# SITE_DESCRIPTION="..."   # optional; a sensible default ships in config/site.php

# Shown on the contact page and in the footer. Leave empty and both degrade
# gracefully rather than printing a blank mailto link.
CONTACT_EMAIL=

#--------------------------------------------------------------------------
# Google AdSense
#--------------------------------------------------------------------------
# Leave EMPTY until AdSense issues a publisher ID. While it is empty:
#   - no AdSense script is loaded
#   - no ad containers render
#   - /ads.txt returns 404 instead of publishing a made-up entry
# The site works normally either way.
#
# Format (from your AdSense account, exactly as given):
#   ADSENSE_CLIENT_ID=ca-pub-0000000000000000
ADSENSE_CLIENT_ID=
ADSENSE_AUTO_ADS=true

#--------------------------------------------------------------------------
# Session and cookies
#--------------------------------------------------------------------------
# PRODUCTION over HTTPS: set SESSION_SECURE_COOKIE=true so cookies are only
# sent over TLS, and SESSION_SAME_SITE=lax.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

#--------------------------------------------------------------------------
# Database
#--------------------------------------------------------------------------
# No tool on this site requires a database; these are Laravel defaults.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

#--------------------------------------------------------------------------
# Infrastructure
#--------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Mail
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
